[Unit]
Description=Media organizer (compress the D: and MEGA libraries, sweep Downloads)

[Service]
Type=simple
WorkingDirectory=/home/rafavcc/dev/media-organizer
ExecStart=/usr/bin/python3 -m media_organizer.cli run
Environment=PYTHONUNBUFFERED=1
CPUQuota=800%
Nice=19
IOSchedulingClass=idle
Restart=on-failure
RestartSec=60
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=default.target
